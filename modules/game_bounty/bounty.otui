BountyHudRow < Label
  height: 14
  font: verdana-11px-rounded
  color: #e0e0e0
  text-auto-resize: false
  phantom: true

BountyHud < UIWidget
  id: bountyHud
  width: 250
  height: 24
  padding: 4
  background-color: #00000099
  border-width: 1
  border-color: #7a1f1f
  phantom: true
  focusable: false
  layout:
    type: verticalBox
    fit-children: true

  Label
    id: title
    height: 15
    font: verdana-11px-rounded
    color: #ff5050
    text-auto-resize: false
    phantom: true

BountyWindow < MainWindow
  id: bountyWindow
  text: Poner recompensa
  size: 300 250
  @onEscape: modules.game_bounty.closeWindow()

  Label
    id: nameLabel
    anchors.top: parent.top
    anchors.left: parent.left
    text: Personaje buscado:

  TextEdit
    id: targetName
    anchors.top: nameLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    max-length: 30

  Label
    id: amountLabel
    anchors.top: targetName.bottom
    anchors.left: parent.left
    margin-top: 8
    text: Recompensa (Tibia coins):

  TextEdit
    id: amount
    anchors.top: amountLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    max-length: 6

  Label
    id: durationLabel
    anchors.top: amount.bottom
    anchors.left: parent.left
    margin-top: 8
    text: Tiempo para cazarlo:

  ComboBox
    id: duration
    anchors.top: durationLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3

  Label
    id: summary
    anchors.top: duration.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    height: 30
    text-wrap: true
    text-auto-resize: false
    color: #c0c0c0

  Label
    id: status
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: placeButton.top
    margin-bottom: 6
    height: 28
    text-wrap: true
    text-auto-resize: false
    color: #ffd04f

  Button
    id: placeButton
    anchors.right: cancelButton.left
    anchors.bottom: parent.bottom
    width: 90
    margin-right: 6
    text: Poner recompensa
    @onClick: modules.game_bounty.submit()

  Button
    id: cancelButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 64
    text: Cerrar
    @onClick: modules.game_bounty.closeWindow()
